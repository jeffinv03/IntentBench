# intentbench credentials.
#
#   cp .env.example .env
#
# then paste your values into .env. That file is gitignored; this one is not,
# so never put a real key here. Variables already exported in your shell take
# precedence over .env.

# Required for `--judge anthropic` (the default).
# Create one at https://console.anthropic.com -> Settings -> API Keys.
ANTHROPIC_API_KEY=

# Only needed if the API answers "This API key is not scoped to a workspace".
# Copy the workspace ID from Console -> Settings -> Workspaces.
ANTHROPIC_WORKSPACE_ID=

# Only needed for `--judge openai` (experimental).
OPENAI_API_KEY=
